# GlitchTip environment — copy to .env and fill in. NEVER commit .env.
# (.env is already covered by the repo-root .gitignore.)

# ── Postgres ─────────────────────────────────────────────────────────────────
# Strong random password for the glitchtip Postgres role.
POSTGRES_PASSWORD=change_me_generate_with_openssl_rand_base64_32

# ── GlitchTip Django settings ────────────────────────────────────────────────
# Strong random secret (openssl rand -base64 48). Rotating invalidates sessions.
SECRET_KEY=change_me_generate_with_openssl_rand_base64_48

# Public origin the app is served on (through the Cloudflare Tunnel).
GLITCHTIP_DOMAIN=https://glitchtip.apecs.dev

# Outbound mail. For a first boot with no SMTP, use consolemail:// to log mail.
# EMAIL_URL=consolemail://
# SMTP example: smtp://user:pass@smtp.provider.tld:587
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=glitchtip@apecs.dev

# ── Cloudflare Tunnel ────────────────────────────────────────────────────────
# Token from `cloudflared tunnel token <tunnel>` (Zero Trust dashboard).
TUNNEL_TOKEN=change_me_cloudflared_tunnel_token
