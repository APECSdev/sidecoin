# GlitchTip DSN for the web app (Astro PUBLIC_* — exposed to the client).
# Empty => error tracking disabled, zero network calls. First rollout target.
# The production value (public key, non-secret) is set on the deploy-web CI
# build step; for local testing use:
#   PUBLIC_GLITCHTIP_DSN=https://d82d1c9b-05ec-49a1-b8e5-341416cdce24@glitchtip.apecs.dev/1
PUBLIC_GLITCHTIP_DSN=

# Build identifier tagged on every event as `dist` (CI sets the commit SHA).
PUBLIC_GLITCHTIP_DIST=
